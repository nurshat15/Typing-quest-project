typedef enum {
    BYTE_HAPPY, BYTE_SAD, BYTE_EXCITED, BYTE_SURPRISED, BYTE_THINKING,
    BYTE_WINKING, BYTE_DETERMINED, BYTE_FOCUSED, BYTE_CHEERING,
    BYTE_THUMBS_UP, BYTE_LOVE
} ByteExpression;
static void byte_say(ByteExpression expr, const char *msg) {
    const char *face;
    switch (expr) {
        case BYTE_HAPPY:      face = "(^_^)"; break;
        case BYTE_SAD:        face = "(T_T)"; break;
        case BYTE_EXCITED:    face = "(^O^)"; break;
        case BYTE_SURPRISED:  face = "(O_O)"; break;
        case BYTE_THINKING:   face = "(._.)?"; break;
        case BYTE_WINKING:    face = "(^_~)"; break;
        case BYTE_DETERMINED: face = "(>_<)"; break;
        case BYTE_FOCUSED:    face = "(o_o)"; break;
        case BYTE_CHEERING:   face = "\\(^o^)/"; break;
        case BYTE_THUMBS_UP:  face = "(d_b)"; break;
        case BYTE_LOVE:       face = "(*_*)"; break;
        default:              face = "(^_^)"; break;
    }
    printf("\n  %s  %sByte:%s %s\"%s\"%s\n", face, CYAN BOLD, RESET, YELLOW, msg, RESET);
}
